generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Shop {
  id                   String    @id @default(cuid())
  domain               String    @unique
  accessToken          String?
  refreshToken         String?
  accessTokenExpiresAt DateTime?
  scope                String?
  name                 String?
  email                String?
  currency             String?
  timezone             String?
  planName             String?
  installedAt          DateTime  @default(now())
  uninstalledAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model ComplianceRequest {
  id        String   @id @default(cuid())
  topic     String
  shop      String
  payload   String
  createdAt DateTime @default(now())

  @@index([shop, topic])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
